Options -Indexes
php_value upload_max_filesize 4M
php_value post_max_size 6M
php_value max_file_uploads 20

RewriteEngine On

# Do not serve repository metadata if it is ever uploaded by mistake.
RewriteRule (^|/)\.git(?:/|$) - [F,L]

# Upgrade public traffic to HTTPS when it is available through Apache.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<FilesMatch "(^\.env(?:\.|$)|composer\.(?:json|lock)$|.*\.sql$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
