
# Environment files
/.env
/.env.*
!/.env.example

# Logs
/storage/logs/*
/storage/email-logs/*

# Private, data-bearing database migration export
/database/infinityfree-migration.sql

# Composer dependencies
/vendor/
!/vendor/
/vendor/*
!/vendor/.htaccess

# User uploads stay out of source control; retain only their access rules.
/uploads/*
!/uploads/.htaccess
!/uploads/payment-proofs/
!/uploads/products/
!/uploads/profile-photos/
/uploads/payment-proofs/*
!/uploads/payment-proofs/.htaccess
/uploads/products/*
!/uploads/products/.htaccess
/uploads/profile-photos/*
!/uploads/profile-photos/.htaccess
!.gitkeep
